<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE siop_document [
<!ELEMENT siop_document (temperatures, levels, components, scenarios?)>
<!ELEMENT temperatures (temp+)>
<!ELEMENT temp EMPTY>
<!ATTLIST temp
          type (AP|BAT|USB|CHG|PA|WIFI) #REQUIRED
          default CDATA "1"
          min CDATA "1"
          max CDATA "1"
          step CDATA "1"
          init CDATA "5"
          hold CDATA "1"
          gap CDATA "0">
<!ELEMENT levels (level+)>
<!ELEMENT level EMPTY>
<!ATTLIST level
          id CDATA #REQUIRED
          temp CDATA #REQUIRED>
<!ELEMENT components (component+)>
<!ELEMENT component (limiter+)>
<!ATTLIST component
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED>
<!ELEMENT scenarios (scenario*, scenario_group*)>
<!ELEMENT scenario (limiter+)>
<!-- you can use below delimiter on scenario name -->
<!-- "!" : intent, ":" : package, "," : plural    -->
<!ATTLIST scenario
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED
          priority CDATA "0">
<!ELEMENT scenario_group (scenario+)>
<!ELEMENT scenario EMPTY>
<!ATTLIST scenario
          name CDATA #REQUIRED
          limiter CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA "370"
          gap CDATA "20"
          value CDATA #REQUIRED>
<!ELEMENT limiter EMPTY>
<!ATTLIST limiter
          name CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA "370"
          gap CDATA "20"
          value CDATA #REQUIRED>
]>

<siop_document>

    <overheatcontrol>
        <complex>
            <SS     formula="AP*BAT*PA"  temp="720.460.750" />
            <LTB    formula="AP*SKIN*PA" temp="520.490.500" />
            <LCD    formula="AP*SKIN*PA" temp="500.470.480" />
            <GDMLTB formula="AP*SKIN*PA" temp="480.470.480" />
            <GDM    formula="AP*SKIN*PA" temp="460.450.460" />
        </complex>
    </overheatcontrol>

    <modelsettings>
        <Skin type="LRP"/>
        <sensors>
            <LTB_SENSOR type="PALM" />
        </sensors>
    </modelsettings>

    <components>

        <component name="AP" tempType="SKIN" >
            <limiter name="CPUFreqMax" step="0" temp="360:380:450:470" value="-1:1378000:1378000:1040000" />
            <limiter name="GPUFreqMax" step="0" temp="360:380:450:470" value="-1:377000:377000:200000"  />
        </component>

        <component name="DISPLAY" tempType="SKIN">
            <limiter name="Brightness" temp="390" value="-1:199:142" />
            <limiter name="MultiWindow" temp="450:470:500" value="-1:1:1" delay="0:300:0" />
        </component>

    </components>

    <scenarios>

        <scenario name="ScreenOff" tempType="SKIN" priority="1" >
            <limiter name="DexOptCpuset" temp="340:350" value="-1:1" />
        </scenario>

        <scenario name="SIPStart" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450"     value="-1:1378000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450"     value="-1:377000"  />
        </scenario>

        <scenario name="AppStart" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450"     value="-1:1378000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450"     value="-1:377000"  />
        </scenario>

        <scenario name="Badge" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450"     value="-1:1378000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450"     value="-1:377000"  />
        </scenario>

        <scenario name="CallStart" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450"     value="-1:1378000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450"     value="-1:377000"  />
        </scenario>

        <scenario name="WakeUp" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450"     value="-1:1378000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450"     value="-1:377000"  />
        </scenario>

        <scenario name="VtCallControl" tempType="SKIN" priority="2">
            <limiter name="Brightness" temp="410" value="199:142" />
            <limiter name="CameraFps"  temp="360" value="-1:1" />
        </scenario>

        <scenario name="CameraRecording!Camera_recording,Camera_recordingDual" tempType="SKIN" priority="1" >
            <limiter name="Brightness" temp="330:350:390:410:430" value="-1:255:255:199:142" />
        </scenario>

        <scenario name="CameraLiveFocusPreview!Camera_preview_LiveFocusVideo" tempType="SKIN" priority="2" >
            <limiter name="GPUFreqMax" step="0" temp="320:350:400:440" value="-1:650000:572000:433000"  />
        </scenario>

        <scenario name="Navigation" tempType="SKIN" >
            <limiter name="Brightness" temp="410" value="167:142" />
            <limiter name="CameraFps"  temp="370"             value="-1:1"            />
        </scenario>

        <scenario name="Heavyuser" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450:470" value="-1:1040000" /> 
            <limiter name="GPUFreqMax" cond="for_temporary" temp="390:440" value="-1:572000" />
        </scenario>

        <scenario name="HeavyLoadApp" tempType="SKIN" priority="1">
            <limiter name="CPUFreqMax" temp="340"             value="-1:1664000:1560000:1248000:1040000" />
            <limiter name="GPUFreqMax"                        value="325000" />
            <limiter name="Brightness" temp="410:430:530:550" value="224:169:169:104" />
        </scenario>

        <scenario name="MultiWindow" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" step="0" temp="360:380:400:420:440:470" value="-1:1560000:1560000:1040000:1040000:936000" />
        </scenario>

        <scenario name="Dex" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" step="0" temp="360:380:400:420:440:470" value="-1:1560000:1560000:1040000:1040000:936000" />
        </scenario>

        <scenario_group name="GameThermalCpuControl" tempType="SKIN" >
            <scenario id="-6"  limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1378000:728000"  />
            <scenario id="-5"  limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1378000:819000"  />
            <scenario id="-4"  limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1378000:936000"  />
            <scenario id="-3"  limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1378000:1040000" />
            <scenario id="-2"  limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1378000:1144000" />
            <scenario id="-1"  limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1378000:1248000" />
            <scenario id="0"   limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1456000:1378000" />
            <scenario id="1"   limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1560000:1456000" />
            <scenario id="2"   limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1664000:1560000" />
            <scenario id="3"   limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1820000:1664000" />
            <scenario id="4"   limiter="CPUFreqMax"                             value="-1"                 />
        </scenario_group>

        <scenario_group name="GameThermalGpuControl" tempType="SKIN" >
            <scenario id="-2" limiter="GPUFreqMax" step="0" temp="370:380:400" value="-1:325000:260000" />
            <scenario id="-1" limiter="GPUFreqMax" step="0" temp="370:380:400" value="-1:377000:325000" />
            <scenario id="0"  limiter="GPUFreqMax" step="0" temp="370:380:400" value="-1:433000:377000" />
            <scenario id="1"  limiter="GPUFreqMax" step="0" temp="370:380:400" value="-1:572000:433000" />
            <scenario id="2"  limiter="GPUFreqMax" step="0" temp="370:380:400" value="-1:754000:572000" />
            <scenario id="3"  limiter="GPUFreqMax"                             value="-1"               />
        </scenario_group>

    </scenarios>

</siop_document>